{
	"compilerOptions": {
		"target": "ES2020",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"isolatedModules": true, // For ts-jest config
		"outDir": "dist",
		"rootDir": "src",
		"esModuleInterop": true,
		"strict": true,
		"allowJs": true,
		"checkJs": false,
		"noEmit": true, // Don’t emit anything (we use ts-node)
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
